# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Dropbox
.dropbox
.dropbox.attr
.dropbox.cache/

# Obsidian (personal workspace state)
.obsidian/

# Playwright MCP cache
.playwright-mcp/

# Node
node_modules/

# 一時ファイル・作業メモ（CLAUDE.md 準拠）
tmp/

# リサーチ生データ（collect.js で再生成可能・サイズ大）
research/*.json

# パイプライン実行出力（各段階の中間・最終成果物。サイズ大・再生成可能）
research/runs/*
!research/runs/.gitkeep

# 最安値リサーチの実行出力（各段階の中間・最終成果物。サイズ大・再生成可能）
cheapest-price-research/runs/*
!cheapest-price-research/runs/.gitkeep

# 最安値リサーチ contact-sheet-builder.py 用 Python venv (Pillow など)
cheapest-price-research/.venv/

# リサーチレポート（ひとまず ignore。コミット運用を決めたら外す）
reports/

# 出品実行出力
listings/runs/*
!listings/runs/.gitkeep

# 精度検証レポートのディレクトリ自体は残したいので .gitkeep だけ許可、配下は ignore
!procedures/exclude_by_keywords_precision_check/reports/
procedures/exclude_by_keywords_precision_check/reports/*
!procedures/exclude_by_keywords_precision_check/reports/.gitkeep

# 仕入れ判断者からのフィードバック（個別回答が含まれるため共有しない）
docs/research/mercari/feedbacks/

# 精度検証の実行ログ（エージェント生成物、サイズ大・再生成可能）
# runs/ ディレクトリ自体は残したいので .gitkeep だけ許可、配下は無視
procedures/exclude_by_keywords_precision_check/runs/*
!procedures/exclude_by_keywords_precision_check/runs/.gitkeep
